{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "scripts/run-checks.mjs",
    "src/index.ts",
    "apps/desktop/src/**/*.test.{ts,tsx}"
  ],
  "ignoreBinaries": ["semgrep"],
  "project": [
    "src/**/*.ts",
    "apps/desktop/src/**/*.{ts,tsx}",
    "scripts/**/*.mjs",
    "*.config.cjs",
    "*.config.js",
    "*.config.ts"
  ],
  "ignoreDependencies": [
    "@commitlint/cli",
    "@secretlint/secretlint-rule-preset-recommend",
    "lint-staged"
  ]
}
