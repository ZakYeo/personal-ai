{
  "assistant": {
    "name": "Jarvis",
    "timeZone": "Europe/London",
    "wakePhrases": ["hey jarvis"]
  },
  "intent": {
    "provider": "openai",
    "openai": {
      "model": "gpt-5.6-luna",
      "reasoningEffort": "none"
    }
  },
  "conversation": {
    "provider": "openai",
    "history": {
      "maxTurnsBeforeCompaction": 5
    },
    "openai": {
      "model": "gpt-5.6-luna",
      "reasoningEffort": "none"
    }
  },
  "responseRewriter": {
    "provider": "openai",
    "openai": {
      "model": "gpt-5.6-luna",
      "reasoningEffort": "none"
    }
  },
  "voice": {
    "input": "sox-rec",
    "streamingAudioInput": "sox-rec-stream",
    "streamingAudioOutput": "sox-play-stream",
    "streamingSpeechToText": "openai-realtime",
    "streamingTextToSpeech": "openai-streaming",
    "wakeActivation": "openwakeword-command",
    "wakeWord": "text-prefix",
    "speechToText": "command",
    "textToSpeech": "command",
    "audioOutput": "sox-play"
  },
  "desktopVoice": {
    "wakeAudioInput": {
      "command": "rec",
      "args": [
        "-q",
        "-r",
        "16000",
        "-c",
        "1",
        "-b",
        "16",
        "{output}",
        "trim",
        "0",
        "4"
      ],
      "timeoutMs": 7000
    },
    "wakeActivation": {
      "command": ".venv/bin/python",
      "args": [
        "scripts/openwakeword-listener.py",
        "--model",
        "hey jarvis",
        "--threshold",
        "0.25"
      ],
      "environmentAllowlist": ["PULSE_SERVER"],
      "timeoutMs": 86400000
    },
    "streamingAudioInput": {
      "command": "sox",
      "args": [
        "-q",
        "-t",
        "pulseaudio",
        "default",
        "-r",
        "24000",
        "-c",
        "1",
        "-b",
        "16",
        "-e",
        "signed-integer",
        "-t",
        "raw",
        "-",
        "trim",
        "0",
        "8",
        "silence",
        "1",
        "0.1",
        "1%",
        "1",
        "0.8",
        "1%"
      ],
      "environmentAllowlist": ["PULSE_SERVER"],
      "timeoutMs": 11000
    },
    "streamingAudioOutput": {
      "command": "sox",
      "args": [
        "-q",
        "-t",
        "raw",
        "-r",
        "24000",
        "-e",
        "signed-integer",
        "-b",
        "16",
        "-c",
        "1",
        "-",
        "-t",
        "pulseaudio",
        "default",
        "pad",
        "0.75"
      ],
      "environmentAllowlist": ["PULSE_SERVER"],
      "timeoutMs": 60000
    },
    "openAIRealtimeTranscription": {
      "model": "gpt-realtime-whisper"
    },
    "openAIStreamingSpeech": {
      "model": "gpt-4o-mini-tts",
      "voice": "marin",
      "instructions": "Speak in a warm, natural British English voice. Sound calm and conversational, with varied intonation and brief natural pauses. Avoid an announcer-like cadence. Read the supplied text exactly; do not add or omit words.",
      "maxAudioBytes": 16777216,
      "responseFormat": "pcm",
      "timeoutMs": 30000
    },
    "audioInput": {
      "command": "sox",
      "args": [
        "-q",
        "-t",
        "pulseaudio",
        "default",
        "-r",
        "16000",
        "-c",
        "1",
        "-b",
        "16",
        "{output}",
        "trim",
        "0",
        "8"
      ],
      "environmentAllowlist": ["PULSE_SERVER"],
      "timeoutMs": 11000
    },
    "speechToText": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "test -n \"$OPENAI_API_KEY\" || { echo 'OPENAI_API_KEY is not set' >&2; exit 2; }\ncurl --fail --silent --show-error --request POST --url https://api.openai.com/v1/audio/transcriptions --header \"Authorization: Bearer $OPENAI_API_KEY\" --header 'Content-Type: multipart/form-data' --form file=@\"$1\" --form model=gpt-4o-transcribe --form response_format=text",
        "sh",
        "{input}"
      ],
      "timeoutMs": 30000
    },
    "textToSpeech": {
      "command": "/bin/sh",
      "args": ["scripts/openai-audio-command.sh", "speak", "{output}"],
      "environmentAllowlist": ["OPENAI_API_KEY"],
      "stdin": "{text}",
      "timeoutMs": 30000
    },
    "audioOutput": {
      "command": "sox",
      "args": ["-q", "{input}", "-t", "pulseaudio", "default", "pad", "0.75"],
      "environmentAllowlist": ["PULSE_SERVER"],
      "timeoutMs": 60000
    }
  },
  "features": {
    "briefing": {
      "enabled": true,
      "adapter": "file",
      "state": {
        "path": "state/briefings.json"
      }
    },
    "calendar": {
      "enabled": true,
      "adapter": "google",
      "eventGrouping": {
        "provider": "openai",
        "openai": {
          "model": "gpt-5.6-luna",
          "reasoningEffort": "none"
        }
      },
      "google": {}
    },
    "internetSearch": {
      "enabled": true,
      "adapter": "openai",
      "maxResults": 5,
      "openai": {
        "model": "gpt-5.6-luna",
        "reasoningEffort": "none"
      }
    },
    "weather": {
      "enabled": true,
      "adapter": "openMeteo",
      "clothingAdvisor": {
        "provider": "openai",
        "openai": {
          "model": "gpt-5.6-luna",
          "reasoningEffort": "none"
        }
      },
      "watches": {
        "adapter": "file",
        "state": {
          "path": "state/weather-watches.json"
        }
      }
    },
    "messaging": {
      "enabled": true,
      "adapter": "mock"
    },
    "alarms": {
      "enabled": true,
      "adapter": "file",
      "state": {
        "path": "state/alarms.json"
      },
      "confirmationRequiredCapabilities": ["alarm.create"]
    },
    "tasks": {
      "enabled": true,
      "adapter": "file",
      "state": {
        "path": "state/tasks.json"
      }
    },
    "profile": {
      "enabled": true,
      "adapter": "file",
      "state": {
        "path": "state/profile.json"
      }
    }
  }
}
