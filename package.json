{
  "name": "personal-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first personal assistant built with a ports-and-adapters architecture.",
  "type": "module",
  "bin": {
    "personal-ai": "dist/runtimes/cli/main.js"
  },
  "files": [
    "config",
    "dist",
    "README.md"
  ],
  "scripts": {
    "architecture:check": "depcruise src apps/desktop/src --config .dependency-cruiser.cjs",
    "architecture:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot",
    "benchmark:voice:aggregate": "node --import tsx src/runtimes/voice-benchmark/benchmark-aggregate-main.ts",
    "benchmark:voice:build-drivers": "node --import tsx src/runtimes/voice-benchmark/build-drivers-main.ts",
    "benchmark:voice:capture": "node --import tsx src/runtimes/voice-benchmark/capture-main.ts",
    "benchmark:voice:report": "node --import tsx src/runtimes/voice-benchmark/benchmark-report-main.ts",
    "benchmark:voice:run": "node --import tsx src/runtimes/voice-benchmark/desktop-benchmark-main.ts",
    "benchmark:voice:verify-artifacts": "node --import tsx src/runtimes/voice-benchmark/artifact-verify-main.ts",
    "bin:check": "npm run build && node scripts/check-bin.mjs",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run format:check && npm run package:sort:check && npm run docs:lint && npm run spellcheck && npm run secrets:check && npm run knip && npm run duplicates && npm run architecture:check && npm run semgrep:check && npm run semgrep:test && npm run bin:check && npm run smoke:package && npm run test:run && npm run typecheck && npm run desktop:check",
    "cli": "node --env-file-if-exists=.env --import tsx src/runtimes/cli/main.ts",
    "desktop:architecture": "depcruise apps/desktop/src --config .dependency-cruiser.cjs",
    "desktop:build": "vite build --config apps/desktop/vite.config.ts",
    "desktop:check": "npm run desktop:lint && npm run desktop:typecheck && npm run desktop:test && npm run desktop:build && npm run desktop:architecture && npm run desktop:duplicates && npm run desktop:native:format && npm run desktop:native:metadata && npm run desktop:native:check && npm run semgrep:check && npm run desktop:e2e",
    "desktop:dev": "vite --config apps/desktop/vite.config.ts",
    "desktop:duplicates": "jscpd apps/desktop/src",
    "desktop:e2e": "playwright test --config apps/desktop/playwright.config.ts",
    "desktop:lint": "eslint apps/desktop/src apps/desktop/vite.config.ts",
    "desktop:native:check": "node scripts/check-desktop-native.mjs",
    "desktop:native:format": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml -- --check",
    "desktop:native:metadata": "cargo metadata --manifest-path apps/desktop/src-tauri/Cargo.toml --no-deps --format-version 1",
    "desktop:native:test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "desktop:tauri:build": "tauri build --config apps/desktop/src-tauri/tauri.conf.json",
    "desktop:tauri:dev": "tauri dev --config apps/desktop/src-tauri/tauri.conf.json",
    "desktop:test": "vitest --run --config apps/desktop/vite.config.ts",
    "desktop:typecheck": "tsc --noEmit -p apps/desktop/tsconfig.json",
    "docs:lint": "markdownlint-cli2 \"**/*.md\"",
    "duplicates": "jscpd src test apps/desktop/src",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "knip": "knip",
    "lint": "eslint .",
    "package:sort": "sort-package-json",
    "package:sort:check": "sort-package-json --check",
    "secrets:check": "secretlint \"**/*\"",
    "semgrep:check": "SEMGREP_ENABLE_VERSION_CHECK=0 SEMGREP_LOG_FILE=/tmp/personal-ai-semgrep.log SEMGREP_SETTINGS_FILE=/tmp/personal-ai-semgrep-settings.yml SEMGREP_SEND_METRICS=off semgrep scan --jobs 1 --no-git-ignore --config semgrep-rules/desktop.yml --strict --error apps/desktop/src src/runtimes/presentation src/runtimes/voice",
    "semgrep:test": "SEMGREP_ENABLE_VERSION_CHECK=0 SEMGREP_LOG_FILE=/tmp/personal-ai-semgrep.log SEMGREP_SETTINGS_FILE=/tmp/personal-ai-semgrep-settings.yml SEMGREP_SEND_METRICS=off semgrep scan --jobs 1 --test --config semgrep-rules/desktop.yml --strict semgrep-rules/desktop.test.tsx",
    "setup:google-calendar": "node --env-file-if-exists=.env scripts/setup-google-calendar-oauth.mjs",
    "setup:openwakeword": "bash scripts/setup-openwakeword-venv.sh",
    "smoke:desktop-voice:openai": "PERSONAL_AI_RUN_DESKTOP_VOICE_OPENAI_SMOKE=1 node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs --run src/runtimes/desktop-voice-openai-smoke.e2e.test.ts",
    "smoke:package": "npm run build && node scripts/smoke-package.mjs",
    "smoke:pi:qemu": "tsx src/runtimes/pi/pi-qemu-smoke.ts",
    "spellcheck": "cspell .",
    "start": "npm run cli -- desktop-voice-service --config config/local-desktop-voice-openai.json",
    "test": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:e2e:open-meteo": "PERSONAL_AI_RUN_OPEN_METEO_E2E=1 node ./node_modules/vitest/vitest.mjs --run src/adapters/open-meteo/open-meteo-weather.e2e.test.ts",
    "test:e2e:openai": "PERSONAL_AI_RUN_OPENAI_E2E=1 node --env-file=.env ./node_modules/vitest/vitest.mjs --run src/runtimes/openai-intent-routing.e2e.test.ts src/runtimes/openai-clarification-transitions.e2e.test.ts src/runtimes/openai-internet-search.e2e.test.ts src/runtimes/openai-persistent-alarms.e2e.test.ts src/runtimes/openai-persistent-tasks.e2e.test.ts src/runtimes/openai-compound-plans.e2e.test.ts src/runtimes/openai-google-calendar-followup.e2e.test.ts src/runtimes/openai-weather.e2e.test.ts src/runtimes/openai-profile.e2e.test.ts src/runtimes/openai-response-rewriter.e2e.test.ts src/runtimes/openai-briefing.e2e.test.ts src/runtimes/pi/pi-service-openai-alarms.e2e.test.ts",
    "test:e2e:openai:alarms": "PERSONAL_AI_RUN_OPENAI_E2E=1 node --env-file=.env ./node_modules/vitest/vitest.mjs --run src/runtimes/openai-persistent-alarms.e2e.test.ts",
    "test:e2e:openai:briefing": "PERSONAL_AI_RUN_OPENAI_E2E=1 node --env-file=.env ./node_modules/vitest/vitest.mjs --run src/runtimes/openai-briefing.e2e.test.ts",
    "test:e2e:openai:calendar-followup": "PERSONAL_AI_RUN_OPENAI_E2E=1 PERSONAL_AI_RUN_GOOGLE_CALENDAR_FOLLOWUP_E2E=1 node --env-file=.env ./node_modules/vitest/vitest.mjs --run src/runtimes/openai-google-calendar-followup.e2e.test.ts",
    "test:e2e:openai:clarifications": "PERSONAL_AI_RUN_OPENAI_E2E=1 node --env-file=.env ./node_modules/vitest/vitest.mjs --run src/runtimes/openai-clarification-transitions.e2e.test.ts",
    "test:e2e:openai:intent": "PERSONAL_AI_RUN_OPENAI_E2E=1 node --env-file=.env ./node_modules/vitest/vitest.mjs --run src/runtimes/openai-intent-routing.e2e.test.ts",
    "test:e2e:openai:pi": "PERSONAL_AI_RUN_OPENAI_E2E=1 node --env-file=.env ./node_modules/vitest/vitest.mjs --run src/runtimes/pi/pi-service-openai-alarms.e2e.test.ts",
    "test:e2e:openai:plans": "PERSONAL_AI_RUN_OPENAI_E2E=1 node --env-file=.env ./node_modules/vitest/vitest.mjs --run src/runtimes/openai-compound-plans.e2e.test.ts",
    "test:e2e:openai:profile": "PERSONAL_AI_RUN_OPENAI_E2E=1 node --env-file=.env ./node_modules/vitest/vitest.mjs --run src/runtimes/openai-profile.e2e.test.ts",
    "test:e2e:openai:rewriter": "PERSONAL_AI_RUN_OPENAI_E2E=1 node --env-file=.env ./node_modules/vitest/vitest.mjs --run src/runtimes/openai-response-rewriter.e2e.test.ts",
    "test:e2e:openai:search": "PERSONAL_AI_RUN_OPENAI_E2E=1 node --env-file=.env ./node_modules/vitest/vitest.mjs --run src/runtimes/openai-internet-search.e2e.test.ts",
    "test:e2e:openai:tasks": "PERSONAL_AI_RUN_OPENAI_E2E=1 node --env-file=.env ./node_modules/vitest/vitest.mjs --run src/runtimes/openai-persistent-tasks.e2e.test.ts",
    "test:e2e:openai:weather": "PERSONAL_AI_RUN_OPENAI_E2E=1 node --env-file=.env ./node_modules/vitest/vitest.mjs --run src/runtimes/openai-weather.e2e.test.ts",
    "test:file": "vitest --run",
    "test:run": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,json,jsonc,md,yml,yaml,css,scss}": "prettier --write",
    "*.{js,cjs,mjs,ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/eslint-plugin": "^1.6.20",
    "cspell": "^9.8.0",
    "dependency-cruiser": "^16.8.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.0",
    "eslint-plugin-unicorn": "^69.0.0",
    "jscpd": "^5.0.11",
    "jsdom": "^29.1.1",
    "knip": "^5.41.1",
    "lint-staged": "^15.3.0",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.4.2",
    "secretlint": "^13.0.2",
    "sort-package-json": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
